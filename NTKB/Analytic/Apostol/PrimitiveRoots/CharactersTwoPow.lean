import NTKB.Analytic.Apostol.PrimitiveRoots.RealCharactersTwoPow
import NTKB.Analytic.Apostol.PrimitiveRoots.PrimitiveCharacters
import Mathlib.GroupTheory.SpecificGroups.Cyclic

/-!
# The characters `χ_{α,c}` modulo `2^a` (Apostol, §10.11 (24)–(25), Theorems 10.13, 10.15)

For `a ≥ 2`, every odd `n` is `(-1)^{α(n)} 5^{b(n)}` modulo `2^a` (Theorem 10.11, Mathlib's
`ZMod.isComplement'_zpowers_unitFive_neg_one`). Apostol's characters are
`f(n) = (-1)^{α(n)}` (= `χ₄` lifted to `2^a`), `g(n) = e^{2πi b(n)/2^{a-2}}` and
`χ_{α,c} = f^α g^c`. Here `g` is built as the composite
`(ZMod 2^a)ˣ → (ZMod 2^a)ˣ/⟨-1⟩ → ℂˣ`, the second map sending the class of `5` (a generator,
Mathlib's `zpowers_mk_unitFive_eq_top`) to `e^{2πi/2^{a-2}}`.

* **Theorem 10.15** (`isPrimitive_charAC_iff`): for `a ≥ 3`, `χ_{α,c}` is primitive mod `2^a` iff
  `c` is odd. (The kernel of the reduction `(ZMod 2^a)ˣ → (ZMod 2^{a-1})ˣ` is generated by
  `5^{2^{a-3}}`, on which `χ_{α,c}` takes the value `(-1)^c`.)
* **Theorem 10.13** (the parametrized part, `isQuadratic_charAC_iff`): for `a ≥ 3` and
  `1 ≤ c ≤ 2^{a-2}`, `χ_{α,c}` is real iff `c = 2^{a-2}` or `c = 2^{a-3}`.
-/

open ZMod Complex

namespace NTKB.Apostol

/-- `e^{2πi/2^{a-2}}` as a unit. -/
noncomputable def zetaTwoPow (a : ℕ) : ℂˣ :=
  Units.mk0 (exp (2 * Real.pi * I / (2 ^ (a - 2) : ℕ))) (exp_ne_zero _)

lemma zetaTwoPow_val_pow (a k : ℕ) :
    ((zetaTwoPow a : ℂ)) ^ k = exp (2 * Real.pi * I * k / (2 ^ (a - 2) : ℕ)) := by
  rw [zetaTwoPow, Units.val_mk0, ← exp_nat_mul]
  congr 1; ring

lemma zetaTwoPow_pow_eq_one (a : ℕ) : zetaTwoPow a ^ (2 ^ (a - 2)) = 1 := by
  apply Units.ext
  rw [Units.val_pow_eq_pow_val, zetaTwoPow_val_pow, Units.val_one]
  have h : ((2 ^ (a - 2) : ℕ) : ℂ) ≠ 0 := by exact_mod_cast (pow_pos two_pos _).ne'
  rw [show 2 * (Real.pi : ℂ) * I * ((2 ^ (a - 2) : ℕ) : ℂ) / ((2 ^ (a - 2) : ℕ) : ℂ) =
    2 * Real.pi * I by field_simp]
  exact exp_two_pi_mul_I

lemma orderOf_mk_unitFive (a : ℕ) :
    orderOf (QuotientGroup.mk unitFive : (ZMod (2 ^ a))ˣ ⧸ Subgroup.zpowers (-1)) = 2 ^ (a - 2) := by
  rw [orderOf_eq_card_of_forall_mem_zpowers (fun x => by
    rw [zpowers_mk_unitFive_eq_top]; exact Subgroup.mem_top x)]
  have := (isComplement'_zpowers_unitFive_neg_one a).index_eq_card
  rw [Subgroup.index] at this
  rw [this, Nat.card_zpowers, orderOf_unitFive]

/-- Apostol's `g` as a hom on units: `-1 ↦ 1`, `5 ↦ e^{2πi/2^{a-2}}`. -/
noncomputable def gHom (a : ℕ) : (ZMod (2 ^ a))ˣ →* ℂˣ :=
  (monoidHomOfForallMemZpowers
      (g := (QuotientGroup.mk unitFive : (ZMod (2 ^ a))ˣ ⧸ Subgroup.zpowers (-1)))
      (fun x => by rw [zpowers_mk_unitFive_eq_top]; exact Subgroup.mem_top x)
      (g' := zetaTwoPow a)
      (by rw [orderOf_mk_unitFive]; exact orderOf_dvd_of_pow_eq_one (zetaTwoPow_pow_eq_one a))).comp
    (QuotientGroup.mk' _)

/-- Apostol's character `g` mod `2^a` (§10.11 (24)). -/
noncomputable def gChar (a : ℕ) : DirichletCharacter ℂ (2 ^ a) := MulChar.ofUnitHom (gHom a)

lemma gChar_neg_one (a : ℕ) : gChar a (-1) = 1 := by
  have : ((-1 : (ZMod (2 ^ a))ˣ) : ZMod (2 ^ a)) = -1 := by simp
  rw [← this, gChar, MulChar.ofUnitHom_coe, gHom, MonoidHom.comp_apply, QuotientGroup.mk'_apply,
    (QuotientGroup.eq_one_iff _).mpr (Subgroup.mem_zpowers _), map_one, Units.val_one]

lemma gChar_five (a : ℕ) : gChar a 5 = zetaTwoPow a := by
  rw [← coe_unitFive, gChar, MulChar.ofUnitHom_coe, gHom, MonoidHom.comp_apply,
    QuotientGroup.mk'_apply, monoidHomOfForallMemZpowers_apply_gen]

lemma four_dvd_two_pow {a : ℕ} (ha : 2 ≤ a) : 4 ∣ 2 ^ a := by
  have := Nat.pow_dvd_pow 2 ha; norm_num at this; exact this

/-- Apostol's character `f(n) = (-1)^{(n-1)/2}` mod `2^a` (§10.11 (24)): `χ₄` lifted. -/
noncomputable def fChar {a : ℕ} (ha : 2 ≤ a) : DirichletCharacter ℂ (2 ^ a) :=
  DirichletCharacter.changeLevel (four_dvd_two_pow ha) (ZMod.χ₄.ringHomComp (Int.castRingHom ℂ))

lemma fChar_neg_one {a : ℕ} (ha : 2 ≤ a) : fChar ha (-1) = -1 := by
  rw [fChar, changeLevel_apply_neg_one, MulChar.ringHomComp_apply]
  have e1 : ZMod.χ₄ (-1) = -1 := by decide
  simp [e1]

lemma fChar_five {a : ℕ} (ha : 2 ≤ a) : fChar ha 5 = 1 := by
  rw [fChar, changeLevel_apply_five, MulChar.ringHomComp_apply]
  have e5 : ZMod.χ₄ 5 = 1 := by decide
  simp [e5]

/-- Apostol's characters `χ_{α,c} = f^α g^c` mod `2^a` (§10.11 (25)). -/
noncomputable def charAC {a : ℕ} (ha : 2 ≤ a) (α c : ℕ) : DirichletCharacter ℂ (2 ^ a) :=
  fChar ha ^ α * gChar a ^ c

lemma charAC_neg_one {a : ℕ} (ha : 2 ≤ a) (α c : ℕ) : charAC ha α c (-1) = (-1) ^ α := by
  have hu : ((-1 : (ZMod (2 ^ a))ˣ) : ZMod (2 ^ a)) = -1 := by simp
  rw [charAC, MulChar.mul_apply, ← hu, MulChar.pow_apply_coe, MulChar.pow_apply_coe, hu,
    fChar_neg_one, gChar_neg_one, one_pow, mul_one]

lemma charAC_five {a : ℕ} (ha : 2 ≤ a) (α c : ℕ) :
    charAC ha α c 5 = exp (2 * Real.pi * I * c / (2 ^ (a - 2) : ℕ)) := by
  rw [charAC, MulChar.mul_apply, ← coe_unitFive, MulChar.pow_apply_coe, MulChar.pow_apply_coe,
    coe_unitFive, fChar_five, gChar_five, one_pow, one_mul, zetaTwoPow_val_pow]

lemma card_units_two_pow {k : ℕ} (hk : 1 ≤ k) : Nat.card (ZMod (2 ^ k))ˣ = 2 ^ (k - 1) := by
  rw [Nat.card_eq_fintype_card, ZMod.card_units_eq_totient, Nat.totient_prime_pow Nat.prime_two
    (by omega)]
  simp

/-- For `a ≥ 3` the kernel of `(ZMod 2^a)ˣ → (ZMod 2^{a-1})ˣ` is generated by `5^{2^{a-3}}`. -/
lemma ker_unitsMap_two_pow {a : ℕ} (ha : 3 ≤ a) (hdvd : 2 ^ (a - 1) ∣ 2 ^ a) :
    (ZMod.unitsMap hdvd).ker = Subgroup.zpowers (unitFive ^ (2 ^ (a - 3))) := by
  set u : (ZMod (2 ^ a))ˣ := unitFive ^ (2 ^ (a - 3))
  have hord : orderOf u = 2 := by
    rw [orderOf_pow_of_dvd (pow_pos two_pos _).ne' (by
      rw [orderOf_unitFive]; exact Nat.pow_dvd_pow 2 (by omega)), orderOf_unitFive,
      show a - 2 = (a - 3) + 1 by omega, pow_succ, Nat.mul_div_cancel_left _ (pow_pos two_pos _)]
  have hu : u ∈ (ZMod.unitsMap hdvd).ker := by
    rw [MonoidHom.mem_ker, map_pow, unitsMap_unitFive, show a - 3 = a - 1 - 2 by omega,
      ← orderOf_unitFive, pow_orderOf_eq_one]
  have hle : Subgroup.zpowers u ≤ (ZMod.unitsMap hdvd).ker := (Subgroup.zpowers_le).mpr hu
  symm
  refine Subgroup.eq_of_le_of_card_ge hle ?_
  rw [Nat.card_zpowers, hord]
  have hsurj := ZMod.unitsMap_surjective (m := 2 ^ a) hdvd
  have h1 := Subgroup.card_mul_index (ZMod.unitsMap hdvd).ker
  rw [Subgroup.index_ker, MonoidHom.range_eq_top.mpr hsurj, Subgroup.card_top,
    card_units_two_pow (by omega : 1 ≤ a - 1), card_units_two_pow (by omega : 1 ≤ a)] at h1
  have e : 2 ^ (a - 1) = 2 * 2 ^ (a - 1 - 1) := by
    rw [← pow_succ']; congr 1; omega
  have := Nat.eq_of_mul_eq_mul_right (pow_pos two_pos _) (h1.trans e)
  omega

lemma charAC_five_pow {a : ℕ} (ha : 3 ≤ a) (α c : ℕ) :
    charAC (by omega) α c ((unitFive ^ (2 ^ (a - 3)) : (ZMod (2 ^ a))ˣ) : ZMod (2 ^ a)) =
      (-1) ^ c := by
  rw [Units.val_pow_eq_pow_val, coe_unitFive, map_pow, charAC_five, ← exp_nat_mul,
    show a - 2 = (a - 3) + 1 by omega]
  rw [show ((2 ^ (a - 3) : ℕ) : ℂ) * (2 * Real.pi * I * c / ((2 ^ (a - 3 + 1) : ℕ) : ℂ)) =
      c * (Real.pi * I) by
    have : ((2 ^ (a - 3) : ℕ) : ℂ) ≠ 0 := by exact_mod_cast (pow_pos two_pos _).ne'
    push_cast
    field_simp
    ring, exp_nat_mul, exp_pi_mul_I]

/-- **Theorem 10.15**: for `a ≥ 3`, the character `χ_{α,c}` mod `2^a` is primitive iff `c` is
odd. -/
@[kb "apostol1976" "Thm 10.15, p. 221"]
theorem isPrimitive_charAC_iff {a : ℕ} (ha : 3 ≤ a) (α c : ℕ) :
    (charAC (by omega : 2 ≤ a) α c).IsPrimitive ↔ Odd c := by
  have hdvd : 2 ^ (a - 1) ∣ 2 ^ a := pow_dvd_pow 2 (by omega)
  rw [isPrimitive_iff_not_factorsThrough Nat.prime_two (by omega),
    DirichletCharacter.factorsThrough_iff_ker_unitsMap hdvd, ker_unitsMap_two_pow ha hdvd,
    Subgroup.zpowers_le, MonoidHom.mem_ker, Units.ext_iff, MulChar.coe_toUnitHom,
    charAC_five_pow ha, Units.val_one, neg_one_pow_eq_one_iff_even (by norm_num),
    Nat.not_even_iff_odd]

/-- **Theorem 10.13** (the parametrized statement): for `a ≥ 3` and `1 ≤ c ≤ 2^{a-2}`, the
character `χ_{α,c}` is real iff `c = 2^{a-2}` or `c = 2^{a-3}`. -/
@[kb "apostol1976" "Thm 10.13, p. 220"]
theorem isQuadratic_charAC_iff {a : ℕ} (ha : 3 ≤ a) (α : ℕ) {c : ℕ} (hc1 : 1 ≤ c)
    (hc2 : c ≤ 2 ^ (a - 2)) :
    (charAC (by omega : 2 ≤ a) α c).IsQuadratic ↔ c = 2 ^ (a - 2) ∨ c = 2 ^ (a - 3) := by
  set χ := charAC (by omega : 2 ≤ a) α c
  set n := 2 ^ (a - 2) with hn
  have hn0 : n ≠ 0 := (pow_pos two_pos _).ne'
  have hζ := Complex.isPrimitiveRoot_exp n hn0
  have h5 : χ 5 = exp (2 * Real.pi * I / n) ^ c := by
    rw [charAC_five, ← exp_nat_mul]; congr 1; ring
  have hsplit : n = 2 * 2 ^ (a - 3) := by
    rw [hn, show a - 2 = (a - 3) + 1 by omega, pow_succ, mul_comm]
  -- `χ(5)^2 = 1 ↔ 2^{a-3} ∣ c`
  have key : χ 5 ^ 2 = 1 ↔ 2 ^ (a - 3) ∣ c := by
    rw [h5, ← pow_mul, hζ.pow_eq_one_iff_dvd, hsplit, mul_comm c 2]
    exact Nat.mul_dvd_mul_iff_left two_pos
  have hrange : 2 ^ (a - 3) ∣ c ↔ c = 2 ^ (a - 2) ∨ c = 2 ^ (a - 3) := by
    constructor
    · rintro ⟨k, rfl⟩
      have hM : 0 < 2 ^ (a - 3) := pow_pos two_pos _
      have hk1 : 1 ≤ k := by
        rcases Nat.eq_zero_or_pos k with rfl | h
        · simp at hc1
        · exact h
      have hk2 : k ≤ 2 := by
        rw [hsplit, mul_comm 2] at hc2
        exact Nat.le_of_mul_le_mul_left hc2 hM
      interval_cases k
      · right; ring
      · left; rw [← hn, hsplit]; ring
    · rintro (h | h)
      · rw [h, ← hn, hsplit]; exact dvd_mul_left _ _
      · rw [h]
  rw [← hrange, ← key]
  constructor
  · intro hq
    rcases apply_eq_one_or_neg_one hq (isUnit_five_two_pow a) with h | h <;> rw [h] <;> norm_num
  · intro h2 x
    by_cases hx : IsUnit x
    · right
      have hχ2 : χ ^ 2 = 1 := by
        refine eq_of_apply_neg_one_of_apply_five ?_ ?_
        · have hu : ((-1 : (ZMod (2 ^ a))ˣ) : ZMod (2 ^ a)) = -1 := by simp
          rw [← hu, MulChar.pow_apply_coe, hu, charAC_neg_one, MulChar.one_apply isUnit_one.neg,
            ← pow_mul, mul_comm, pow_mul]
          simp
        · rw [← coe_unitFive, MulChar.pow_apply_coe, coe_unitFive, h2,
            MulChar.one_apply (isUnit_five_two_pow a)]
      obtain ⟨u, rfl⟩ := hx
      have : χ u ^ 2 = 1 := by rw [← MulChar.pow_apply_coe, hχ2, MulChar.one_apply (Units.isUnit u)]
      rw [sq] at this
      exact mul_self_eq_one_iff.mp this
    · left; exact MulChar.map_nonunit _ hx

end NTKB.Apostol
