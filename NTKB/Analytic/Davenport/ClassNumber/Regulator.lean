import NTKB.Attr
import Mathlib.NumberTheory.NumberField.Units.Regulator
import Mathlib.NumberTheory.NumberField.Discriminant.Basic
import Mathlib.NumberTheory.NumberField.Norm

/-! # The regulator of a real quadratic field (Davenport, Chapter 6, row 6-12)

A real quadratic field has unit rank one, so its units are generated by `-1` (or the torsion) and a
fundamental unit `ε`, and its regulator is `log ε`.  Moreover `ε` is a root of `X² - t X ± 1` with
`t ∈ ℤ`, which forces `ε ≥ 3/2` and hence `R ≥ log (3/2)`.
-/

namespace NTKB.Davenport
open NumberField NumberField.Units NumberField.InfinitePlace Module

variable {K : Type*} [Field K] [NumberField K]

private lemma nrComplexPlaces_eq_zero_of_pos_discr (hK : finrank ℚ K = 2) (hD : 0 < discr K) :
    nrComplexPlaces K = 0 := by
  have h := card_add_two_mul_card_eq_rank K
  have hs := sign_discr K
  rw [Int.sign_eq_one_of_pos hD] at hs
  rw [hK] at h
  rcases (by omega : nrComplexPlaces K = 0 ∨ nrComplexPlaces K = 1) with h0 | h1
  · exact h0
  · rw [h1, pow_one] at hs; norm_num at hs

private lemma card_places_eq_two (hK : finrank ℚ K = 2) (hD : 0 < discr K) :
    Fintype.card (InfinitePlace K) = 2 := by
  have h := card_add_two_mul_card_eq_rank K
  have h0 := nrComplexPlaces_eq_zero_of_pos_discr hK hD
  have h2 := card_eq_nrRealPlaces_add_nrComplexPlaces K
  rw [hK, h0] at h
  omega

private lemma rank_eq_one (hK : finrank ℚ K = 2) (hD : 0 < discr K) : rank K = 1 := by
  rw [rank, card_places_eq_two hK hD]

private lemma isReal_of_pos_discr (hK : finrank ℚ K = 2) (hD : 0 < discr K) (w : InfinitePlace K) :
    w.IsReal := by
  rcases w.isReal_or_isComplex with h | h
  · exact h
  · exfalso
    have h0 := nrComplexPlaces_eq_zero_of_pos_discr hK hD
    classical
    have h1 : 0 < Fintype.card {w : InfinitePlace K // w.IsComplex} :=
      Fintype.card_pos_iff.mpr ⟨⟨w, h⟩⟩
    have h2 : Fintype.card {w : InfinitePlace K // w.IsComplex} = nrComplexPlaces K :=
      Fintype.card_congr (Equiv.refl _)
    omega

/-- A real quadratic field has a fundamental unit. -/
theorem exists_fundamental_unit (hK : finrank ℚ K = 2) (hD : 0 < discr K) :
    ∃ ε : (𝓞 K)ˣ, Subgroup.closure {ε} ⊔ torsion K = ⊤ := by
  have hr := rank_eq_one hK hD
  refine ⟨fundSystem K ⟨0, by omega⟩, ?_⟩
  have : Set.range (fundSystem K) = {fundSystem K ⟨0, by omega⟩} := by
    ext y
    simp only [Set.mem_range, Set.mem_singleton_iff]
    constructor
    · rintro ⟨i, rfl⟩
      congr 1
      exact Fin.ext (by have := i.2; omega)
    · rintro rfl
      exact ⟨_, rfl⟩
  rw [← this]
  exact closure_fundSystem_sup_torsion_eq_top K

/-- In rank one, the regulator of any family is `|log w (u 0)|` for every infinite place `w`. -/
private lemma regOfFamily_eq_abs_log (hK : finrank ℚ K = 2) (hD : 0 < discr K)
    (u : Fin (rank K) → (𝓞 K)ˣ) (i : Fin (rank K)) (w : InfinitePlace K) :
    regOfFamily u = |Real.log (w (u i : K))| := by
  classical
  have hr := rank_eq_one hK hD
  have hc := card_places_eq_two hK hD
  obtain ⟨w', hw'⟩ := Fintype.exists_ne_of_one_lt_card (by omega) w
  have hcard : Fintype.card {x : InfinitePlace K // x ≠ w'} = rank K := by
    rw [Fintype.card_subtype_compl, Fintype.card_subtype_eq]
    rw [hr, hc]
  let e : {x : InfinitePlace K // x ≠ w'} ≃ Fin (rank K) := Fintype.equivFinOfCardEq hcard
  have : Unique (Fin (rank K)) := by rw [hr]; infer_instance
  have : Unique {x : InfinitePlace K // x ≠ w'} := Equiv.unique e
  rw [regOfFamily_eq_det u w' e, Matrix.det_unique]
  have h1 : (default : {x : InfinitePlace K // x ≠ w'}) = ⟨w, hw'.symm⟩ := Subsingleton.elim _ _
  have h2 : e ⟨w, hw'.symm⟩ = i := Subsingleton.elim _ _
  have h3 : (mult w : ℝ) = 1 := by
    simp [mult, isReal_of_pos_discr hK hD w]
  simp only [Matrix.of_apply, h1, h2, h3, one_mul]

/-- Every unit of a real quadratic field satisfies `x² - t x + n = 0` with `t ∈ ℤ`, `n = ±1`
under every embedding. -/
private lemma exists_quad_rel (hK : finrank ℚ K = 2) (ε : (𝓞 K)ˣ) (ψ : K →ₐ[ℚ] ℂ) :
    ∃ t n : ℤ, (n = 1 ∨ n = -1) ∧ (ψ (ε : 𝓞 K) : ℂ) ^ 2 - t * ψ (ε : 𝓞 K) + n = 0 := by
  classical
  refine ⟨Algebra.trace ℤ (𝓞 K) (ε : 𝓞 K), Algebra.norm ℤ (ε : 𝓞 K), ?_, ?_⟩
  · exact Int.isUnit_iff.mp (Units.isUnit (Units.map (Algebra.norm ℤ : 𝓞 K →* ℤ) ε))
  · have hcard : (Finset.univ : Finset (K →ₐ[ℚ] ℂ)).card = 2 := by
      rw [Finset.card_univ, AlgHom.card, hK]
    obtain ⟨a, b, hab, hu⟩ := Finset.card_eq_two.mp hcard
    have ht := trace_eq_sum_embeddings (K := ℚ) (L := K) ℂ (x := ((ε : 𝓞 K) : K))
    have hn := Algebra.norm_eq_prod_embeddings ℚ ℂ ((ε : 𝓞 K) : K)
    rw [hu, Finset.sum_pair hab] at ht
    rw [hu, Finset.prod_pair hab] at hn
    have ht' : ((Algebra.trace ℤ (𝓞 K) (ε : 𝓞 K) : ℤ) : ℂ) = a (ε : K) + b (ε : K) := by
      rw [← ht, ← Algebra.coe_trace_int]
      simp
    have hn' : ((Algebra.norm ℤ (ε : 𝓞 K) : ℤ) : ℂ) = a (ε : K) * b (ε : K) := by
      rw [← hn, ← Algebra.coe_norm_int]
      simp
    rw [ht', hn']
    have hψ : ψ ∈ (Finset.univ : Finset (K →ₐ[ℚ] ℂ)) := Finset.mem_univ _
    rw [hu] at hψ
    rcases Finset.mem_insert.mp hψ with h | h
    · rw [h]; ring
    · rw [Finset.mem_singleton.mp h]; ring

private lemma pos_aux (x : ℝ) (t n : ℤ) (hn : n = 1 ∨ n = -1) (h : x ^ 2 - t * x + n = 0)
    (h0 : 1 < x) (h2 : x < 3 / 2) : False := by
  rcases hn with rfl | rfl
  · push_cast at h
    have h3 : (2 : ℝ) < t := by
      by_contra hc
      push Not at hc
      nlinarith [sq_nonneg (x - 1), mul_le_mul_of_nonneg_right hc (by linarith : (0:ℝ) ≤ x)]
    have h4 : (t : ℝ) < 3 := by
      by_contra hc
      push Not at hc
      nlinarith [mul_le_mul_of_nonneg_right hc (by linarith : (0:ℝ) ≤ x)]
    have h5 : 2 < t := by exact_mod_cast h3
    have h6 : t < 3 := by exact_mod_cast h4
    omega
  · push_cast at h
    have h3 : (0 : ℝ) < t := by
      by_contra hc
      push Not at hc
      nlinarith [mul_le_mul_of_nonneg_right hc (by linarith : (0:ℝ) ≤ x)]
    have h4 : (t : ℝ) < 1 := by
      by_contra hc
      push Not at hc
      nlinarith [mul_le_mul_of_nonneg_right hc (by linarith : (0:ℝ) ≤ x)]
    have h5 : 0 < t := by exact_mod_cast h3
    have h6 : t < 1 := by exact_mod_cast h4
    omega

private lemma abs_aux (x : ℝ) (t n : ℤ) (hn : n = 1 ∨ n = -1) (h : x ^ 2 - t * x + n = 0)
    (h1 : 1 < |x|) (h2 : |x| < 3 / 2) : False := by
  rcases lt_or_gt_of_ne (abs_pos.mp (by linarith) : x ≠ 0) with hx | hx
  · rw [abs_of_neg hx] at h1 h2
    refine pos_aux (-x) (-t) n hn ?_ h1 h2
    push_cast
    linarith
  · rw [abs_of_pos hx] at h1 h2
    exact pos_aux x t n hn h h1 h2

/-- **The regulator of a real quadratic field is `log ε`** (Davenport §6, p. 49): for a
fundamental unit `ε` and any infinite place `w`, `R = |log w(ε)|`. -/
@[kb "davenport1980" "Ch 6, p. 49"]
theorem regulator_eq_abs_log (hK : finrank ℚ K = 2) (hD : 0 < discr K) (ε : (𝓞 K)ˣ)
    (hε : Subgroup.closure {ε} ⊔ torsion K = ⊤) (w : InfinitePlace K) :
    regulator K = |Real.log (w (ε : K))| := by
  have hr := rank_eq_one hK hD
  have hset : Set.range (fun _ : Fin (rank K) => ε) = {ε} := by
    ext y
    simp only [Set.mem_range, Set.mem_singleton_iff]
    constructor
    · rintro ⟨i, rfl⟩; rfl
    · rintro rfl; exact ⟨⟨0, by omega⟩, rfl⟩
  have hidx := regOfFamily_div_regulator (K := K) (fun _ : Fin (rank K) => ε)
  rw [hset, hε, Subgroup.index_top, Nat.cast_one,
    div_eq_one_iff_eq (regulator_ne_zero K)] at hidx
  rw [← hidx]
  exact regOfFamily_eq_abs_log hK hD _ ⟨0, by omega⟩ w

/-- The regulator of a real quadratic field is at least `log (3/2)`: a unit `ε` with
`1 < |ε| < 3/2` at a real place would have `ε ± 1/ε`, its trace, strictly between two
consecutive integers. -/
theorem log_three_halves_le_regulator (hK : finrank ℚ K = 2) (hD : 0 < discr K) :
    Real.log (3 / 2) ≤ regulator K := by
  obtain ⟨ε, hε⟩ := exists_fundamental_unit hK hD
  have hc := card_places_eq_two hK hD
  obtain ⟨w⟩ : Nonempty (InfinitePlace K) := Fintype.card_pos_iff.mp (by omega)
  have hR := regulator_eq_abs_log hK hD ε hε w
  have hreal := isReal_of_pos_discr hK hD w
  obtain ⟨t, n, hn, hq⟩ := exists_quad_rel hK ε (embedding w).toRatAlgHom
  set x : ℝ := embedding_of_isReal hreal (ε : K) with hx
  have hxc : ((embedding w).toRatAlgHom ((ε : 𝓞 K)) : ℂ) = (x : ℂ) := by
    rw [hx, embedding_of_isReal_apply]
    rfl
  rw [hxc] at hq
  have hq' : x ^ 2 - t * x + n = 0 := by exact_mod_cast hq
  have habs : |x| = w (ε : K) := by
    rw [← Real.norm_eq_abs, hx, norm_embedding_of_isReal]
  have hpos : 0 < w (ε : K) := by
    rw [InfinitePlace.pos_iff]
    exact coe_ne_zero ε
  by_contra hlt
  push Not at hlt
  rw [hR] at hlt
  have hreg : 0 < |Real.log (w (ε : K))| := hR ▸ regulator_pos K
  have hlt' := abs_lt.mp hlt
  have hlog32 : Real.log (2 / 3) = - Real.log (3 / 2) := by
    rw [← Real.log_inv]; norm_num
  have ha1 : w (ε : K) < 3 / 2 :=
    (Real.log_lt_log_iff hpos (by norm_num)).mp hlt'.2
  have ha2 : 2 / 3 < w (ε : K) :=
    (Real.log_lt_log_iff (by norm_num) hpos).mp (by rw [hlog32]; exact hlt'.1)
  have hne : w (ε : K) ≠ 1 := by
    intro h
    rw [h, Real.log_one, abs_zero] at hreg
    exact lt_irrefl _ hreg
  rcases lt_or_gt_of_ne hne with hlo | hhi
  · -- use the other root `y = t - x`
    have hxy : (t - x) * x = n := by linarith
    have hy : |t - x| * w (ε : K) = 1 := by
      rw [← habs, ← abs_mul, hxy]
      rcases hn with rfl | rfl <;> simp
    refine abs_aux (t - x) t n hn (by nlinarith) ?_ ?_
    · nlinarith
    · nlinarith
  · exact abs_aux x t n hn hq' (by rw [habs]; exact hhi) (by rw [habs]; exact ha1)

end NTKB.Davenport
